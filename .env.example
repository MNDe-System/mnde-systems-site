# MNDe environment configuration (no secrets committed).
# Set these in the Cloudflare Pages project settings (Production + Preview).

# --- Contact mail provider (Resend) ---
# Without RESEND_API_KEY and CONTACT_FROM, POST /api/contact returns an explicit
# 503 MAIL_NOT_CONFIGURED error — it never fakes success.
RESEND_API_KEY=
# Verified sender, e.g. "MNDe <noreply@mndesystems.com>"
CONTACT_FROM=
# Destination inbox for inbound requests (default: contact@mndesystems.com)
CONTACT_TO=contact@mndesystems.com

# --- Analytics (optional, privacy-first) ---
# If unset, analytics is disabled cleanly with no runtime failure.
# The site loads Plausible from https://plausible.io when configured.
PLAUSIBLE_DOMAIN=
